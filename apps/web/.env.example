# Copy to apps/web/.env.local for local development (`yarn dev` does this for you).
# On Fly, set these with `fly secrets set NAME=value`.

# Where the app is reached. On Fly: https://<your-app>.fly.dev
APP_URL=http://localhost:3000

# Postgres (docker compose runs one on :5433 for local dev)
DATABASE_URL=postgres://architech:architech@localhost:5433/architech

# Long random string. `yarn dev` fills this in locally. Required in production.
BETTER_AUTH_SECRET=

# AI (OpenRouter). Get a key at https://openrouter.ai/keys
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
AI_VISION_MODEL=google/gemini-4-argon
AI_IMAGE_MODEL=openai/gpt-image-2.5-sunburst

# Photo storage. Fly production uses Tigris AWS_* / BUCKET_NAME secrets automatically.
# Alternatively use Cloudflare R2 (set R2_ACCOUNT_ID + keys + bucket).
# Local: the SeaweedFS S3 container from docker compose (defaults below).
R2_ACCOUNT_ID=
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY_ID=architech
S3_SECRET_ACCESS_KEY=architech-secret
S3_BUCKET=architech
S3_CREATE_BUCKET=true

# Extra allowed origins, comma separated (only needed for custom domains).
TRUSTED_ORIGINS=

# Optional "Continue with Google"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
