{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "test": {
      "outputs": [],
      "env": ["DATABASE_URL", "TEST_DATABASE_URL", "WEB_TEST_DATABASE_URL"]
    },
    "typecheck": {
      "outputs": []
    },
    "lint": {
      "outputs": []
    }
  }
}
